# ==============================================================================
#  NEXT.JS APPLICATION CORE CONFIGURATION
# ==============================================================================
# The current environment deployment state (development, production, test)
NODE_ENV=development

# The base URL of the application (crucial for absolute redirects, metadata, and SSR)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ==============================================================================
#  SUPABASE (Database, Auth & Storage)
# ==============================================================================
# Project Settings -> API in your Supabase dashboard.

# Safe to expose to the browser — used by the client-side Supabase SDK.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only. Bypasses Row Level Security — never expose to the client,
# only use it in Route Handlers / Server Actions (e.g. payment webhooks).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here


# ==============================================================================
#  PAYMENT GATEWAY CONFIGURATION (Example: Stripe)
# ==============================================================================
# Not wired up yet — placeholders for the upcoming Premium/Gift checkout flow.

# Secret key used strictly on the backend / server-side route handlers
STRIPE_SECRET_KEY=sk_test_51Nx...your_stripe_secret_here

# Public key safe to expose to the frontend client
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51Nx...your_stripe_public_here

# Webhook signing secret used to verify Stripe backend events locally
STRIPE_WEBHOOK_SECRET=whsec_...your_stripe_webhook_secret_here


# ==============================================================================
#  EMAIL / SMTP SERVICE CONFIGURATION (Example: Resend, SendGrid)
# ==============================================================================
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com
