# ==============================================================================
#  NEXT.JS APPLICATION CORE CONFIGURATION
# ==============================================================================
# The current environment deployment state (development, production, test)
NODE_ENV=development

# The base URL of the application (crucial for absolute redirects, metadata, and SSR)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ==============================================================================
#  AUTHENTICATION & SECURITY (e.g., NextAuth.js / Auth.js / Clerk)
# ==============================================================================
# Generate a secure 32-byte secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Third-party OAuth Providers (Example: Google)
GOOGLE_CLIENT_ID=your_google_client_://googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here


# ==============================================================================
#  DATABASE CONNECTION (e.g., Prisma, Drizzle, Mongoose)
# ==============================================================================
# Connection string for your primary database (PostgreSQL, MySQL, MongoDB, etc.)
DATABASE_URL=postgresql://johndoe:mypassword@localhost:5432/mydb?schema=public


# ==============================================================================
#  PAYMENT GATEWAY CONFIGURATION (Example: Stripe)
# ==============================================================================
# Secret key used strictly on the backend / server-side route handlers
STRIPE_SECRET_KEY=sk_test_51Nx...your_stripe_secret_here

# Public key safe to expose to the frontend client
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51Nx...your_stripe_public_here

# Webhook signing secret used to verify Stripe backend events locally
STRIPE_WEBHOOK_SECRET=whsec_...your_stripe_webhook_secret_here


# ==============================================================================
#  EMAIL / SMTP SERVICE CONFIGURATION (Example: Resend, SendGrid)
# ==============================================================================
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com


# ==============================================================================
#  EXTERNAL STORAGE / FILE UPLOADS (Example: AWS S3, Cloudinary)
# ==============================================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
